<!-- ===== JAVASCRIPT ===== -->


<!-- ===== MODAL AUTOCONTRATAÇÃO ===== -->
<div class="modal-overlay" id="modalContratar" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    
    <!-- Header -->
    <div class="modal-header">
      <h2 id="modalTitle">Contratação Colab+</h2>
      <button class="modal-close" onclick="fecharModalContratar()" aria-label="Fechar">&times;</button>
    </div>

    <!-- Progress bar -->
    <div class="modal-progress">
      <div class="progress-step active" id="pstep1">
        <div class="progress-step-num">1</div>
        <div class="progress-step-label">Dados</div>
      </div>
      <div class="progress-connector" id="pconn1"></div>
      <div class="progress-step" id="pstep2">
        <div class="progress-step-num">2</div>
        <div class="progress-step-label">Contrato</div>
      </div>
      <div class="progress-connector" id="pconn2"></div>
      <div class="progress-step" id="pstep3">
        <div class="progress-step-num">3</div>
        <div class="progress-step-label">Assinatura</div>
      </div>
    </div>

    <div class="modal-body">

      <!-- PASSO 1 — Dados da empresa -->
      <div class="modal-step-panel active" id="modalStep1">
        
        <div class="modal-form-section">
          <div class="modal-form-section-title">Pacote selecionado</div>
          <div class="form-group">
            <label for="mFieldPacote">Pacote Colab+ <span class="required">*</span></label>
            <select id="mFieldPacote" class="form-control" required>
              <option value="">— Selecione o pacote —</option>
              <optgroup label="─── Plano Inicial ───">
                <option value="Inicial · 10 a 30 colaboradores">Inicial · 10 a 30 colaboradores — R$259,90/mês</option>
                <option value="Inicial · 31 a 50 colaboradores">Inicial · 31 a 50 colaboradores — R$429,90/mês</option>
                <option value="Inicial · 51 a 70 colaboradores">Inicial · 51 a 70 colaboradores — R$599,90/mês</option>
                <option value="Inicial · 71 a 100 colaboradores">Inicial · 71 a 100 colaboradores — R$849,90/mês</option>
              </optgroup>
              <optgroup label="─── Plano Completo ───">
                <option value="Completo · 10 a 30 colaboradores">Completo · 10 a 30 colaboradores — R$389,90/mês</option>
                <option value="Completo · 31 a 50 colaboradores">Completo · 31 a 50 colaboradores — R$649,90/mês</option>
                <option value="Completo · 51 a 70 colaboradores">Completo · 51 a 70 colaboradores — R$909,90/mês</option>
                <option value="Completo · 71 a 100 colaboradores">Completo · 71 a 100 colaboradores — R$1.299,90/mês</option>
              </optgroup>
              <optgroup label="─── Plano Super ───">
                <option value="Super · 10 a 30 colaboradores">Super · 10 a 30 colaboradores — R$529,90/mês</option>
                <option value="Super · 31 a 50 colaboradores">Super · 31 a 50 colaboradores — R$879,90/mês</option>
                <option value="Super · 51 a 70 colaboradores">Super · 51 a 70 colaboradores — R$1.229,90/mês</option>
                <option value="Super · 71 a 100 colaboradores">Super · 71 a 100 colaboradores — R$1.749,90/mês</option>
              </optgroup>
            </select>
            <span class="form-error err-modal" id="mErrPacote">Por favor, selecione um pacote.</span>
          </div>
        </div>

        <hr class="form-divider" />

        <div class="modal-form-section">
          <div class="modal-form-section-title">Dados da empresa</div>
          <div class="form-group">
            <label for="mFieldRazaoSocial">Razão Social <span class="required">*</span></label>
            <input type="text" id="mFieldRazaoSocial" class="form-control" placeholder="Ex: Empresa Exemplo Ltda" required>
            <span class="form-error err-modal" id="mErrRazaoSocial">Informe a razão social da empresa.</span>
          </div>
          <div class="form-group">
            <label for="mFieldCnpj">CNPJ <span class="required">*</span></label>
            <input type="text" id="mFieldCnpj" class="form-control" placeholder="00.000.000/0001-00" maxlength="18" required>
            <span class="form-error err-modal" id="mErrCnpj">Informe um CNPJ válido (14 dígitos).</span>
          </div>
          <div class="form-group">
            <label for="mFieldFantasia">Nome Fantasia / Marca</label>
            <input type="text" id="mFieldFantasia" class="form-control" placeholder="Ex: Empresa Exemplo">
          </div>
          <div class="form-group">
            <label for="mFieldEndereco">Endereço (logradouro) <span class="required">*</span></label>
            <input type="text" id="mFieldEndereco" class="form-control" placeholder="Ex: Rua das Flores, 123" required>
            <span class="form-error err-modal" id="mErrEndereco">Informe o endereço da empresa.</span>
          </div>
          <div class="form-row">
            <div class="form-group" style="flex:2">
              <label for="mFieldCidade">Cidade <span class="required">*</span></label>
              <input type="text" id="mFieldCidade" class="form-control" required>
              <span class="form-error err-modal" id="mErrCidade">Informe a cidade.</span>
            </div>
            <div class="form-group" style="flex:1">
              <label for="mFieldEstado">Estado <span class="required">*</span></label>
              <select id="mFieldEstado" class="form-control" required>
                <option value="">UF</option>
                <option>AC</option><option>AL</option><option>AM</option><option>AP</option>
                <option>BA</option><option>CE</option><option>DF</option><option>ES</option>
                <option>GO</option><option>MA</option><option>MG</option><option>MS</option>
                <option>MT</option><option>PA</option><option>PB</option><option>PE</option>
                <option>PI</option><option>PR</option><option>RJ</option><option>RN</option>
                <option>RO</option><option>RR</option><option>RS</option><option>SC</option>
                <option>SE</option><option>SP</option><option>TO</option>
              </select>
              <span class="form-error err-modal" id="mErrEstado">Selecione o estado.</span>
            </div>
            <div class="form-group" style="flex:1">
              <label for="mFieldCep">CEP <span class="required">*</span></label>
              <input type="text" id="mFieldCep" class="form-control" placeholder="00000-000" maxlength="9" required>
              <span class="form-error err-modal" id="mErrCep">Informe o CEP.</span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="mFieldTelEmp">Telefone <span class="required">*</span></label>
              <input type="tel" id="mFieldTelEmp" class="form-control" placeholder="(11) 99999-9999" maxlength="15" required>
              <span class="form-error err-modal" id="mErrTelEmp">Informe o telefone da empresa.</span>
            </div>
            <div class="form-group">
              <label for="mFieldEmailEmp">E-mail corporativo <span class="required">*</span></label>
              <input type="email" id="mFieldEmailEmp" class="form-control" placeholder="contato@empresa.com.br" required>
              <span class="form-error err-modal" id="mErrEmailEmp">Informe um e-mail corporativo válido.</span>
            </div>
          </div>
        </div>

        <hr class="form-divider" />

        <div class="modal-form-section">
          <div class="modal-form-section-title">Ponto focal (responsável pelo contrato)</div>
          <div class="form-group">
            <label for="mFieldFocalNome">Nome completo <span class="required">*</span></label>
            <input type="text" id="mFieldFocalNome" class="form-control" placeholder="Ex: Maria da Silva" required>
            <span class="form-error err-modal" id="mErrFocalNome">Informe o nome do responsável.</span>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="mFieldFocalCargo">Cargo <span class="required">*</span></label>
              <input type="text" id="mFieldFocalCargo" class="form-control" placeholder="Ex: Gerente de RH" required>
              <span class="form-error err-modal" id="mErrFocalCargo">Informe o cargo.</span>
            </div>
            <div class="form-group">
              <label for="mFieldFocalTel">Telefone <span class="required">*</span></label>
              <input type="tel" id="mFieldFocalTel" class="form-control" placeholder="(11) 99999-9999" maxlength="15" required>
              <span class="form-error err-modal" id="mErrFocalTel">Informe o telefone.</span>
            </div>
          </div>
          <div class="form-group">
            <label for="mFieldFocalEmail">E-mail <span class="required">*</span></label>
            <input type="email" id="mFieldFocalEmail" class="form-control" placeholder="maria@empresa.com.br" required>
            <span class="form-error err-modal" id="mErrFocalEmail">Informe um e-mail válido.</span>
          </div>
        </div>

        <hr class="form-divider" />

        <div class="form-group">
          <label for="mFieldColabs">Número de colaboradores <span class="required">*</span></label>
          <input type="number" id="mFieldColabs" class="form-control" placeholder="Ex: 25" min="10" max="100" required>
          <span class="form-error err-modal" id="mErrColabs">Informe o número de colaboradores (10 a 100).</span>
        </div>

        <button class="btn-modal-next" onclick="modalStep1Next()">Revisar contrato →</button>
      </div>

      <!-- PASSO 2 — Revisão do contrato -->
      <div class="modal-step-panel" id="modalStep2">
        <p style="color:#555;margin-bottom:12px;font-size:0.9rem;">Leia o contrato completo antes de avançar. O botão de assinatura ficará disponível ao chegar ao final.</p>
        
        <div class="contract-area" id="contractArea">
          <!-- Generated dynamically -->
        </div>
        
        <p class="scroll-hint" id="scrollHint">↓ Role até o final do contrato para continuar</p>

        <button class="btn-modal-next" id="btnAvancarAssinatura" onclick="modalStep2Next()" disabled>Avançar para assinatura →</button>
        <button class="btn-modal-back" onclick="modalGoTo(1)">← Voltar</button>
      </div>

      <!-- PASSO 3 — Assinatura -->
      <div class="modal-step-panel" id="modalStep3">
        <div class="assinatura-summary" id="assinaturaSummary">
          <!-- Summary injected dynamically -->
        </div>

        <div class="form-group">
          <label for="mFieldAssinatura">Digite seu nome completo para assinar <span class="required">*</span></label>
          <input type="text" id="mFieldAssinatura" class="form-control" placeholder="Deve ser idêntico ao nome do ponto focal">
          <span class="form-error err-modal" id="mErrAssinatura">O nome digitado deve ser idêntico ao nome do ponto focal informado.</span>
        </div>

        <div class="checkbox-group-modal">
          <input type="checkbox" id="mCheckTermos">
          <label for="mCheckTermos" id="mCheckTermosLabel">Declaro que li integralmente o contrato acima, que tenho poderes para assinar em nome da empresa, e que concordo com todos os termos e condições.</label>
        </div>
        <span class="err-modal" id="mErrCheckTermos">Você precisa marcar esta declaração para continuar.</span>

        <button class="btn-modal-next" onclick="modalStep3Confirm()">✓ Confirmar assinatura e contratar</button>
        <button class="btn-modal-back" onclick="modalGoTo(2)">← Voltar ao contrato</button>
      </div>

      <!-- PASSO 4 — Sucesso -->
      <div class="modal-step-panel" id="modalStep4">
        <div class="modal-success">
          <div class="success-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="white"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          </div>
          <h3>Contrato assinado com sucesso! 🎉</h3>
          <p id="successDateTime"></p>
          <div class="assinatura-summary" id="successSummary" style="text-align:left;margin:20px 0;"></div>
          <p>Em até <strong>3 dias úteis</strong> nosso time entrará em contato para iniciar a ativação.</p>
          <p style="margin-top:16px;font-size:0.9rem;color:#666;">Guarde este número de protocolo:</p>
          <div class="protocol-num" id="protocolNum"></div>
          <button class="btn-modal-next" onclick="fecharModalContratar()" style="margin-top:28px;">Fechar</button>
        </div>
      </div>

    </div>
  </div>
</div>
<script>
(function() {
  'use strict';

  /* ===== PRICE TABLE ===== */
  var precos = {
    "Inicial":  { "10-30": 259.90, "31-50": 429.90, "51-70": 599.90, "71-100": 849.90 },
    "Completo": { "10-30": 389.90, "31-50": 649.90, "51-70": 909.90, "71-100": 1299.90 },
    "Super":    { "10-30": 529.90, "31-50": 879.90, "51-70": 1229.90, "71-100": 1749.90 }
  };

  /* Features per plan */
  var planFeatures = {
    "Inicial": [
      "4 consultas online por mês com médicos, psicólogos e nutricionistas (Starbem)",
      "Até 80% de desconto em medicamentos para colaborador e dependentes (Avus)"
    ],
    "Completo": [
      "Tudo do Plano Inicial (Starbem + Avus)",
      "Acesso a mais de 30 mil academias com Wellhub (antigo Gympass)"
    ],
    "Super": [
      "Tudo do Plano Completo (Starbem + Avus + Wellhub)",
      "Pronto socorro online ilimitado com profissionais da rede Dasa",
      "Desconto em exames laboratoriais e consultas presenciais (Dasa)",
      "Desconto em vacinas (Dasa)",
      "Desconto em cirurgias (Dasa)"
    ]
  };

  /* Faixa display labels for dropdown value */
  var faixaLabel = {
    "10-30":  "10 a 30 colaboradores",
    "31-50":  "31 a 50 colaboradores",
    "51-70":  "51 a 70 colaboradores",
    "71-100": "71 a 100 colaboradores"
  };

  function getFaixa(n) {
    if (n < 10) return null;       // abaixo do mínimo
    if (n <= 30) return "10-30";
    if (n <= 50) return "31-50";
    if (n <= 70) return "51-70";
    if (n <= 100) return "71-100";
    return null;                   // >100, fale com consultor
  }

  /* ===== HAMBURGER MENU ===== */
  var hamburgerBtn = document.getElementById('hamburgerBtn');
  var mobileMenu = document.getElementById('mobileMenu');

  hamburgerBtn.addEventListener('click', function() {
    var isOpen = mobileMenu.classList.contains('open');
    mobileMenu.classList.toggle('open');
    hamburgerBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  window.closeMobileMenu = function() {
    mobileMenu.classList.remove('open');
    hamburgerBtn.setAttribute('aria-expanded', 'false');
  };

  /* ===== SCROLL TOP BUTTON ===== */
  var scrollTopBtn = document.getElementById('scrollTop');
  window.addEventListener('scroll', function() {
    if (window.scrollY > 400) {
      scrollTopBtn.classList.add('visible');
    } else {
      scrollTopBtn.classList.remove('visible');
    }
  });

  /* ===== TABLE CONTRATAR (from pricing table) ===== */
  window.tableContratar = function(plano, faixa) {
    // Open modal with pre-selected plan and tier
    abrirModalContratar(plano, faixa);
  };

  /* ===== SIMULATOR ===== */
  var simColaboradores = document.getElementById('simColaboradores');
  var simSlider = document.getElementById('simSlider');
  var simSliderValue = document.getElementById('simSliderValue');
  var simResultContent = document.getElementById('simResultContent');
  var simContactNeeded = document.getElementById('simContactNeeded');
  var simResultEmpty = document.getElementById('simResultEmpty');

  function getSelectedPlano() {
    var radios = document.querySelectorAll('input[name="simPlano"]');
    for (var i = 0; i < radios.length; i++) {
      if (radios[i].checked) return radios[i].value;
    }
    return 'Inicial';
  }

  function formatCurrency(val) {
    return 'R$ ' + val.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }

  function runSimulator() {
    var n = parseInt(simColaboradores.value, 10) || 0;
    var plano = getSelectedPlano();

    // Hide all result panels
    simResultContent.classList.remove('visible');
    simContactNeeded.classList.remove('visible');
    simResultEmpty.style.display = 'none';

    if (n < 10) {
      simResultContent.classList.remove('visible');
      simContactNeeded.classList.remove('visible');
      simResultEmpty.style.display = 'none';
      // Could show a specific message here for minimum 10 employees
      return;
    }

    if (n > 100) {
      simContactNeeded.classList.add('visible');
      window._simSelectedPackage = null;
      window._simSelectedFaixa = null;
      return;
    }

    var faixa = getFaixa(n);
    var preco = precos[plano][faixa];

    if (!preco) {
      simResultEmpty.style.display = 'block';
      return;
    }

    var nomePacote = plano + ' \u00b7 ' + faixaLabel[faixa];

    // Update result UI
    document.getElementById('simResultName').textContent = nomePacote;
    document.getElementById('simResultPrice').textContent = formatCurrency(preco);
    document.getElementById('simMetaColabs').textContent = n;
    // per-life value removed per requirement
    document.getElementById('simMetaPlan').textContent = plano;

    var featuresList = document.getElementById('simFeaturesList');
    featuresList.innerHTML = '';
    var features = planFeatures[plano] || [];
    features.forEach(function(f) {
      var tag = document.createElement('span');
      tag.className = 'sim-feature-tag';
      tag.textContent = f;
      featuresList.appendChild(tag);
    });

    simResultContent.classList.add('visible');

    // Store for CTA
    window._simSelectedPackage = nomePacote;
    window._simSelectedFaixa = faixa;
  }

  // Sync slider and input
  simSlider.addEventListener('input', function() {
    simColaboradores.value = this.value;
    simSliderValue.textContent = this.value;
    runSimulator();
  });

  simColaboradores.addEventListener('input', function() {
    var val = Math.max(1, Math.min(999, parseInt(this.value, 10) || 1));
    var sliderVal = Math.min(150, val);
    simSlider.value = sliderVal;
    simSliderValue.textContent = val;
    runSimulator();
  });

  // Plan radio buttons
  document.querySelectorAll('.sim-plan-option').forEach(function(opt) {
    opt.addEventListener('click', function() {
      document.querySelectorAll('.sim-plan-option').forEach(function(o) { o.classList.remove('selected'); });
      this.classList.add('selected');
      this.querySelector('input[type="radio"]').checked = true;
      runSimulator();
    });
  });

  window.goToContratarFromSim = function() {
    // Open modal with pre-selected plan from simulator
    var plano = getSelectedPlano();
    var faixa = window._simSelectedFaixa;
    if (plano && faixa) {
      abrirModalContratar(plano, faixa);
    } else {
      abrirModalContratar();
    }
  };

  window.preSelectPackage = function(pkgName) {
    // For +100 vidas lead flow: scroll to contratar section
    var el = document.getElementById('contratar');
    if (el) {
      var headerHeight = 80;
      var pos = el.getBoundingClientRect().top + window.pageYOffset - headerHeight;
      window.scrollTo({ top: pos, behavior: 'smooth' });
    }
    // Pre-fill lead form plan if possible
    var leadPlano = document.getElementById('leadPlano');
    if (leadPlano) {
      if (pkgName === 'Personalizado' || pkgName === 'Personalizado (mais de 100 colaboradores)') {
        leadPlano.value = 'Personalizado';
      }
    }
  };

  // Run once on load
  runSimulator();

  /* ===== CNPJ MASK (moved to modal) ===== */

  /* ===== PHONE MASK (moved to modal and lead form) ===== */

  /* ===== FORM VALIDATION (moved to modal flow) ===== */


  /* ===== FAQ ACCORDION ===== */
  document.querySelectorAll('.faq-question').forEach(function(question) {
    function toggleFaq() {
      var item = question.closest('.faq-item');
      var isOpen = item.classList.contains('open');

      // Close all
      document.querySelectorAll('.faq-item.open').forEach(function(openItem) {
        openItem.classList.remove('open');
        openItem.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      });

      // Open current if was closed
      if (!isOpen) {
        item.classList.add('open');
        question.setAttribute('aria-expanded', 'true');
      }
    }

    question.addEventListener('click', toggleFaq);
    question.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleFaq();
      }
    });
  });

})();


  /* ===================================================================
     MODAL AUTOCONTRATAÇÃO — 3 PASSOS
     =================================================================== */
  (function() {

    // State
    var modalData = {};
    var currentStep = 1;
    var contractScrolled = false;

    // Price map (value → price label)
    var priceMap = {
      'Inicial · 10 a 30 colaboradores': 'R$259,90/mês',
      'Inicial · 31 a 50 colaboradores': 'R$429,90/mês',
      'Inicial · 51 a 70 colaboradores': 'R$599,90/mês',
      'Inicial · 71 a 100 colaboradores': 'R$849,90/mês',
      'Completo · 10 a 30 colaboradores': 'R$389,90/mês',
      'Completo · 31 a 50 colaboradores': 'R$649,90/mês',
      'Completo · 51 a 70 colaboradores': 'R$909,90/mês',
      'Completo · 71 a 100 colaboradores': 'R$1.299,90/mês',
      'Super · 10 a 30 colaboradores': 'R$529,90/mês',
      'Super · 31 a 50 colaboradores': 'R$879,90/mês',
      'Super · 51 a 70 colaboradores': 'R$1.229,90/mês',
      'Super · 71 a 100 colaboradores': 'R$1.749,90/mês'
    };

    function todayFormatted() {
      var d = new Date();
      var day = String(d.getDate()).padStart(2,'0');
      var mon = String(d.getMonth()+1).padStart(2,'0');
      var yr = d.getFullYear();
      return day + '/' + mon + '/' + yr;
    }

    function nowFormatted() {
      var d = new Date();
      return d.toLocaleString('pt-BR');
    }

    function extractPlano(pacoteValue) {
      // "Completo · 10 a 30 colaboradores" → "Completo"
      return pacoteValue.split(' ·')[0].split(' —')[0].trim();
    }

    function shouldShowWellhubAnnex(plano) {
      return plano === 'Completo' || plano === 'Super';
    }

    function generateProtocol() {
      return String(Math.floor(10000000 + Math.random() * 90000000));
    }

    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // ---- Progress bar ----
    function updateProgress(step) {
      for (var i = 1; i <= 3; i++) {
        var ps = document.getElementById('pstep' + i);
        ps.classList.remove('active','done');
        if (i < step) ps.classList.add('done');
        else if (i === step) ps.classList.add('active');
      }
      for (var j = 1; j <= 2; j++) {
        var pc = document.getElementById('pconn' + j);
        pc.classList.toggle('done', j < step);
      }
    }

    // ---- Show step ----
    window.modalGoTo = function(step) {
      currentStep = step;
      document.querySelectorAll('.modal-step-panel').forEach(function(p) { p.classList.remove('active'); });
      var panel = document.getElementById('modalStep' + step);
      if (panel) panel.classList.add('active');
      updateProgress(step);
      // Reset scroll on modal box
      document.querySelector('.modal-box').scrollTop = 0;
      // Update title
      var titles = {1:'Passo 1 — Dados da empresa', 2:'Passo 2 — Revisão do contrato', 3:'Passo 3 — Assinatura', 4:'Contrato assinado!'};
      document.getElementById('modalTitle').textContent = titles[step] || 'Contratação Colab+';
    };

    // ---- Open/close ----
    window.abrirModalContratar = function(plano, faixa) {
      contractScrolled = false;
      var btn = document.getElementById('btnAvancarAssinatura');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.45'; btn.style.cursor = 'not-allowed'; }
      document.getElementById('scrollHint').style.display = 'block';

      // Pre-select plan if provided
      if (plano && faixa) {
        var faixaLabels = {
          '10-30': '10 a 30 colaboradores',
          '31-50': '31 a 50 colaboradores',
          '51-70': '51 a 70 colaboradores',
          '71-100': '71 a 100 colaboradores'
        };
        var targetVal = plano + ' · ' + (faixaLabels[faixa] || faixa);
        var sel = document.getElementById('mFieldPacote');
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value === targetVal) { sel.selectedIndex = i; break; }
        }
      }

      document.getElementById('modalContratar').classList.add('active');
      document.body.style.overflow = 'hidden';
      modalGoTo(1);
    };

    window.fecharModalContratar = function() {
      document.getElementById('modalContratar').classList.remove('active');
      document.body.style.overflow = '';
    };

    // Close on overlay click
    document.getElementById('modalContratar').addEventListener('click', function(e) {
      if (e.target === this) fecharModalContratar();
    });

    // Close on ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') fecharModalContratar();
    });

    // ---- Form helpers ----
    function showErr(fieldId, errId, show) {
      var f = document.getElementById(fieldId);
      var e = document.getElementById(errId);
      if (show) {
        if (f) f.classList.add('error');
        if (e) { e.classList.add('visible'); e.style.display = 'block'; }
      } else {
        if (f) f.classList.remove('error');
        if (e) { e.classList.remove('visible'); e.style.display = 'none'; }
      }
    }

    function validateEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e); }
    function validateCnpj(c) { return c.replace(/\D/g,'').length === 14; }
    function validateTel(t) { return t.replace(/\D/g,'').length >= 10; }

    // CNPJ mask for modal
    var mCnpj = document.getElementById('mFieldCnpj');
    if (mCnpj) {
      mCnpj.addEventListener('input', function() {
        var v = this.value.replace(/\D/g,'');
        v = v.replace(/^(\d{2})(\d)/,'$1.$2');
        v = v.replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3');
        v = v.replace(/\.(\d{3})(\d)/,'.$1/$2');
        v = v.replace(/(\d{4})(\d)/,'$1-$2');
        this.value = v;
      });
    }

    // Phone masks for modal
    function applyPhoneMask(fieldId) {
      var el = document.getElementById(fieldId);
      if (!el) return;
      el.addEventListener('input', function() {
        var v = this.value.replace(/\D/g,'');
        v = v.replace(/^(\d{2})(\d)/,'($1) $2');
        v = v.replace(/(\d{5})(\d)/,'$1-$2');
        this.value = v;
      });
    }
    applyPhoneMask('mFieldTelEmp');
    applyPhoneMask('mFieldFocalTel');

    // CEP mask
    var mCep = document.getElementById('mFieldCep');
    if (mCep) {
      mCep.addEventListener('input', function() {
        var v = this.value.replace(/\D/g,'');
        v = v.replace(/^(\d{5})(\d)/,'$1-$2');
        this.value = v;
      });
    }

    // ---- Passo 1 validation & advance ----
    window.modalStep1Next = function() {
      var valid = true;
      var fields = [
        {id:'mFieldPacote', err:'mErrPacote', check:function(v){return !!v;}},
        {id:'mFieldRazaoSocial', err:'mErrRazaoSocial', check:function(v){return v.trim().length>0;}},
        {id:'mFieldCnpj', err:'mErrCnpj', check:function(v){return validateCnpj(v);}},
        {id:'mFieldEndereco', err:'mErrEndereco', check:function(v){return v.trim().length>0;}},
        {id:'mFieldCidade', err:'mErrCidade', check:function(v){return v.trim().length>0;}},
        {id:'mFieldEstado', err:'mErrEstado', check:function(v){return !!v;}},
        {id:'mFieldCep', err:'mErrCep', check:function(v){return v.replace(/\D/g,'').length>=8;}},
        {id:'mFieldTelEmp', err:'mErrTelEmp', check:function(v){return validateTel(v);}},
        {id:'mFieldEmailEmp', err:'mErrEmailEmp', check:function(v){return validateEmail(v);}},
        {id:'mFieldFocalNome', err:'mErrFocalNome', check:function(v){return v.trim().length>0;}},
        {id:'mFieldFocalCargo', err:'mErrFocalCargo', check:function(v){return v.trim().length>0;}},
        {id:'mFieldFocalTel', err:'mErrFocalTel', check:function(v){return validateTel(v);}},
        {id:'mFieldFocalEmail', err:'mErrFocalEmail', check:function(v){return validateEmail(v);}},
        {id:'mFieldColabs', err:'mErrColabs', check:function(v){var n=parseInt(v,10);return n>=10&&n<=100;}}
      ];

      var firstErr = null;
      fields.forEach(function(f) {
        var el = document.getElementById(f.id);
        var ok = f.check(el ? el.value : '');
        showErr(f.id, f.err, !ok);
        if (!ok) { valid = false; if (!firstErr) firstErr = el; }
      });

      if (!valid) {
        if (firstErr) firstErr.scrollIntoView({behavior:'smooth', block:'center'});
        return;
      }

      // Store data
      modalData = {
        pacote: document.getElementById('mFieldPacote').value,
        razaoSocial: document.getElementById('mFieldRazaoSocial').value.trim(),
        cnpj: document.getElementById('mFieldCnpj').value.trim(),
        fantasia: document.getElementById('mFieldFantasia').value.trim(),
        endereco: document.getElementById('mFieldEndereco').value.trim(),
        cidade: document.getElementById('mFieldCidade').value.trim(),
        estado: document.getElementById('mFieldEstado').value,
        cep: document.getElementById('mFieldCep').value.trim(),
        telEmp: document.getElementById('mFieldTelEmp').value.trim(),
        emailEmp: document.getElementById('mFieldEmailEmp').value.trim(),
        focalNome: document.getElementById('mFieldFocalNome').value.trim(),
        focalCargo: document.getElementById('mFieldFocalCargo').value.trim(),
        focalTel: document.getElementById('mFieldFocalTel').value.trim(),
        focalEmail: document.getElementById('mFieldFocalEmail').value.trim(),
        colabs: document.getElementById('mFieldColabs').value
      };
      modalData.plano = extractPlano(modalData.pacote);
      modalData.valorMensal = priceMap[modalData.pacote] || '—';
      modalData.dataHoje = todayFormatted();

      // Generate contract
      generateContract();

      // Reset scroll state
      contractScrolled = false;
      var btn = document.getElementById('btnAvancarAssinatura');
      btn.disabled = true;
      btn.style.opacity = '0.45';
      btn.style.cursor = 'not-allowed';
      document.getElementById('scrollHint').style.display = 'block';

      modalGoTo(2);

      // Setup scroll listener
      setTimeout(function() {
        var ca = document.getElementById('contractArea');
        ca.addEventListener('scroll', onContractScroll);
      }, 200);
    };

    function onContractScroll() {
      var ca = document.getElementById('contractArea');
      var isBottom = ca.scrollHeight - ca.scrollTop - ca.clientHeight < 40;
      if (isBottom && !contractScrolled) {
        contractScrolled = true;
        var btn = document.getElementById('btnAvancarAssinatura');
        btn.disabled = false;
        btn.style.opacity = '';
        btn.style.cursor = '';
        document.getElementById('scrollHint').style.display = 'none';
      }
    }

    function generateContract() {
      var d = modalData;
      var wellhubAnnex = shouldShowWellhubAnnex(d.plano) ? getWellhubAnnex() : '';

      var html = '<div class="contract-header">' +
        '<p><strong>FORMULÁRIO DE CONTRATAÇÃO — COLAB+</strong></p>' +
        '<p>Data: ' + esc(d.dataHoje) + '</p>' +
        '<p>&nbsp;</p>' +
        '<p><strong>PARTES:</strong></p>' +
        '<p>iFood Benefícios e Serviços Ltda., inscrito no CNPJ/MF sob o n. 33.157.312/0001-62, com sede na Avenida dos Autonomistas, n. 1.496, Bloco B, 3º andar, Vila Yara, Osasco/SP, CEP 06.020-902 ("<strong>iFood Benefícios</strong>")</p>' +
        '<p><strong>e</strong></p>' +
        '<p>' + esc(d.razaoSocial) + ', inscrita no CNPJ sob o n. ' + esc(d.cnpj) + ', com sede em ' + esc(d.endereco) + ', ' + esc(d.cidade) + '/' + esc(d.estado) + ', CEP ' + esc(d.cep) + ', telefone ' + esc(d.telEmp) + ', e-mail ' + esc(d.emailEmp) + ' ("<strong>Empresa</strong>")</p>' +
        '<p>&nbsp;</p>' +
        '<p><strong>Plano contratado:</strong> ' + esc(d.pacote) + '</p>' +
        '<p><strong>Número de colaboradores:</strong> ' + esc(d.colabs) + '</p>' +
        '<p><strong>Valor mensal:</strong> ' + esc(d.valorMensal) + '</p>' +
        '<p><strong>Ponto focal:</strong> ' + esc(d.focalNome) + ' | ' + esc(d.focalCargo) + ' | ' + esc(d.focalTel) + ' | ' + esc(d.focalEmail) + '</p>' +
        '</div>';

      html += '<h3>TERMOS E CONDIÇÕES GERAIS DE CONTRATAÇÃO DO COLAB+</h3>';
      html += '<p><em>Atualizado em: 28 de novembro de 2024.</em></p>';
      html += '<p>Este instrumento estabelece os termos e as condições gerais para a contratação pela empresa do Colab+ ("Condições Gerais"), devidamente qualificada ("Empresa"): (i) no formulário de contratação específico e/ou na Proposta Eletrônica do programa de benefícios oferecido pelo iFood Benefícios e Serviços Ltda., inscrito no CNPJ sob o nº 33.157.312/0001-62 ("iFood Benefícios").</p>';

      html += '<h3>1. OBJETO</h3>';
      html += '<p>1.1. O objeto destas Condições Gerais consiste na oferta pelo iFood Benefícios de programa de benefícios para apoio aos colaboradores da Empresa dos serviços de saúde e bem-estar ("Colab+"), que não tenha algum dos benefícios do Colab+ já prestados pelos fornecedores parceiros do iFood Benefícios ("Fornecedores") e/ou esteja em negociação com os Fornecedores. Ao contratar o Colab+ será disponibilizado à Empresa acesso aos serviços oferecidos pelos Fornecedores mediante o pagamento dos planos ou dos programas de apoios individuais contratados pela Empresa, sem custos adicionais, devendo a Empresa ser responsável por encaminhar aos Fornecedores as informações solicitadas para a implantação do(s) serviço(s), necessários para a Empresa utilizar os serviços.</p>';
      html += '<p>1.2. Se aplicável, a Empresa deverá assinar um formulário de adesão com cada um dos Fornecedores. A ausência dessa formalidade poderá impedir a utilização dos serviços de saúde e bem-estar, sem que seja devido pelo iFood Benefícios qualquer reembolso à Empresa.</p>';

      html += '<h3>2. PLANOS DO PROGRAMA</h3>';
      html += '<p>2.1. A Empresa poderá optar por contratar os serviços: "Academia Wellhub", "Cuidado Saúde", "Apoio 360" e "Dasa", conforme plano selecionado.</p>';
      html += '<p>2.2. Cada plano contratado seguirá o processo de implantação acordado com os Fornecedores.</p>';
      html += '<p>2.3. Os serviços contemplados em cada um dos planos consistem em:</p>';
      html += '<ul><li><strong>Cuidado Saúde (Avus):</strong> desconto em consultas médicas, odontológicas, exames laboratoriais e de imagem, desconto em medicamentos em rede de farmácias parceira (até 80%), agendamento imediato de consultas, canais de atendimento (app, 0800 e WhatsApp), serviço de telemedicina e plantão 24 horas com clínico geral.</li>';
      html += '<li><strong>Apoio 360 (Starbem):</strong> 1 consulta médica com clínico geral ou especialista por videochamada por mês, 2 consultas psicológicas por videochamada por mês, 1 consulta nutricional por videochamada por mês.</li>';
      html += '<li><strong>Academia Wellhub</strong> (apenas Planos Completo e Super): acesso à rede de mais de 30 mil academias credenciadas e serviços online disponibilizados no aplicativo Wellhub.</li>';
      html += '<li><strong>Dasa</strong> (apenas Plano Super): pronto atendimento via plataforma "Nav" (teleconsulta, sem custo, ilimitado); exames laboratoriais com até 60% de desconto; pacotes cirúrgicos com descontos e financiamento; vacinas com até 15% de desconto; descontos de até 70% em medicamentos; inclusão de até 4 dependentes sem custo adicional.</li></ul>';
      html += '<p>2.4. A Empresa deverá consultar o valor dos planos no momento da contratação, sendo que a contratação está sujeita à aprovação cadastral da Empresa pelo iFood Benefícios e pelo Fornecedor.</p>';

      html += '<h3>3. ACESSO AOS FORNECEDORES</h3>';
      html += '<p>3.1. O iFood Benefícios não faz qualquer garantia com relação ao desempenho dos Fornecedores. Nada nos presentes termos pode ser interpretado como uma representação ou garantia de que os serviços prestados pelos Fornecedores serão livres de interrupções, indisponibilidades momentâneas ou erros de qualquer natureza.</p>';
      html += '<p>3.1.1. A Empresa reconhece que o acesso poderá ser interrompido temporariamente, independentemente de prévio aviso, devido a: (a) manutenções programadas e/ou emergenciais; (b) motivos de caso fortuito ou força maior; (c) suspeita de uso indevido.</p>';
      html += '<p>3.1.2. O iFood Benefícios, na máxima extensão permitida por lei, não responderá por danos emergentes, lucros cessantes, danos indiretos, multas com clientes e perda de oportunidade.</p>';

      html += '<h3>4. REMUNERAÇÃO</h3>';
      html += '<p>4.1. A Empresa pagará ao iFood Benefícios a remuneração devida pela prestação dos Serviços, referente ao plano contratado, composta pela mensalidade (remuneração mensal fixa) como contrapartida à facilidade de acesso aos serviços disponibilizados pelos Fornecedores.</p>';
      html += '<p>4.2. A cobrança da mensalidade se iniciará após a conclusão do processo de implementação realizado pela Empresa junto aos Fornecedores ou 30 (trinta) dias após a contratação do Colab+, o que ocorrer primeiro.</p>';
      html += '<p>4.3. Em caso de atraso no pagamento dos valores devidos, incidirá sobre o valor em aberto multa não compensatória de 1% (um por cento), acrescido de juros de mora de 1% (um por cento) ao mês, calculado pro rata die.</p>';
      html += '<p>4.3.1. O inadimplemento das obrigações assumidas autoriza o iFood Benefícios a enviar as informações pertinentes para inscrição em órgãos de proteção ao crédito.</p>';
      html += '<p>4.3.2. O iFood Benefícios está igualmente autorizado a protestar títulos de crédito oriundos destas Condições Gerais.</p>';
      html += '<p>4.3.3. O atraso do pagamento superior a 90 dias poderá implicar na suspensão da prestação dos serviços pelos Fornecedores, independentemente de comunicação do iFood Benefícios.</p>';

      html += '<h3>5. POLÍTICA TRIBUTÁRIA</h3>';
      html += '<p>5.1. A Empresa compromete-se a manter sua Regularidade Fiscal sob pena de ser impossibilitada de utilizar os serviços.</p>';
      html += '<p>5.2. As Partes são contratantes independentes, sendo cada uma delas responsável pelo adimplemento das obrigações tributárias que lhes são atribuídas.</p>';
      html += '<p>5.3. A Empresa se responsabiliza pelo recolhimento tempestivo de todos os tributos decorrentes de suas atividades empresariais que são objeto destas Condições Gerais.</p>';

      html += '<h3>6. PRIVACIDADE E PROTEÇÃO DE DADOS PESSOAIS</h3>';
      html += '<p>6.1. As Partes obrigam-se a respeitar a legislação aplicável à proteção de dados pessoais, como a Lei Geral de Proteção de Dados (LGPD — Lei federal nº 13.709/2018), o Marco Civil da Internet (Lei federal nº 12.965/2014) e demais normas setoriais aplicáveis.</p>';
      html += '<p>6.2. As Partes concordam que para os fins do objeto das Condições Gerais não será realizado o compartilhamento de dados pessoais. Caso surja nova atividade que exija compartilhamento, as Partes celebrarão aditivo contratual para regularizar.</p>';

      html += '<h3>7. PRAZO DE VIGÊNCIA E RESCISÃO</h3>';
      html += '<p>7.1. O Contrato Colab+ terá prazo de vigência inicial de 12 (doze) meses contados da data de assinatura do Formulário.</p>';
      html += '<p>7.1.1. <em>Renovação automática.</em> Uma vez transcorrido o prazo inicial, o Contrato será prorrogado automaticamente por iguais e sucessivos períodos, exceto mediante manifestação contrária de qualquer das partes, enviada com 90 (noventa) dias de antecedência.</p>';
      html += '<p>7.2. <em>Rescisão imotivada.</em> A Empresa poderá solicitar a resilição do Contrato, imotivadamente, devendo enviar aviso por escrito ao iFood Benefícios com no mínimo 30 (trinta) dias de antecedência.</p>';
      html += '<p>7.2.1. Na hipótese de não observância do prazo de aviso prévio, a Empresa ficará sujeita a multa calculada com base no valor do Plano contratado multiplicado pelo número de colaboradores.</p>';

      html += '<h3>8. INADIMPLEMENTO</h3>';
      html += '<p>8.1. A Empresa reconhece e concorda que, em caso de descumprimento destas Condições Gerais, estará sujeita à suspensão dos serviços prestados pelos Fornecedores e/ou à rescisão destas Condições Gerais, independentemente de comunicação.</p>';

      html += '<h3>9. ALTERAÇÃO DESTAS CONDIÇÕES GERAIS</h3>';
      html += '<p>9.1. O iFood Benefícios poderá alterar estas Condições Gerais a qualquer tempo, mediante o envio de comunicação com antecedência mínima de 10 (dez) dias corridos.</p>';
      html += '<p>9.1.1. Se a alteração tiver efeito adverso importante sobre a Empresa e esta não concordar, poderá apresentar notificação escrita ao iFood Benefícios no prazo de até 30 dias após o recebimento da comunicação.</p>';

      html += '<h3>10. DISPOSIÇÕES GERAIS</h3>';
      html += '<p>10.1. A Empresa reconhece que caberá a ela utilizar os serviços prestados pelos Fornecedores, mediante assinatura de formulário de adesão, e que referida assinatura eventualmente poderá ser essencial para a implementação dos Serviços.</p>';
      html += '<p>10.2. A Empresa compromete-se a, em caso de término de sua relação com os Parceiros, avisar o iFood Benefícios em até 5 (cinco) dias contados do envio do aviso de rescisão aos Parceiros.</p>';
      html += '<p>10.3. A relação jurídica estabelecida entre as partes é de prestação de serviços, não estabelecendo relação de consumo, trabalho ou representação comercial.</p>';
      html += '<p>10.4. A Empresa poderá cancelar a contratação dos serviços mediante comunicação por escrito com antecedência mínima de 30 dias, sendo devido o pagamento do plano no período.</p>';
      html += '<p>10.5. Estas Condições Gerais serão regidas e interpretadas de acordo com a legislação da República Federativa do Brasil. No caso de qualquer reivindicação ou controvérsia, será observada a Comarca de São Paulo.</p>';

      // ANEXO AVUS (always shown)
      html += '<h3 style="margin-top:28px;border-top:2px solid #E8D5DC;padding-top:20px;">ANEXO ESPECÍFICO — DECLARAÇÃO AVUS</h3>';
      html += '<p><em>Parte integrante dos Termos e Condições Gerais de Contratação do Colab+</em></p>';
      html += '<p>Este Anexo Específico visa estabelecer os termos e condições específicos para a disponibilização do acesso, aos colaboradores da Empresa, ao programa Cuidado Saúde.</p>';
      html += '<h3>I. DECLARAÇÃO</h3>';
      html += '<p>I.1. O iFood Benefícios, por meio do Programa Colab+, garante a possibilidade dos colaboradores aderirem ao programa "Cuidado Saúde", mas não dispensará o pagamento dos serviços utilizados pelos Colaboradores da Empresa.</p>';
      html += '<p>I.2. Para adesão ao programa Cuidado Saúde, a Empresa declara:</p>';
      html += '<p>(i) expressa ciência e anuência aos Termos e Condições do Programa Corporativo da AVUS DESCONTOS E PROMOÇÕES LTDA. ("AVUS"), inscrita no CNPJ nº 25.211.006/0001-39, mediante a assinatura deste Anexo, sendo condição essencial para a disponibilização e manutenção do Programa;</p>';
      html += '<p>(ii) estar ciente de que a atuação do Parceiro AVUS se dará de forma independente, autônoma e sem qualquer ingerência do iFood Benefícios.</p>';
      html += '<p>I.2.2. A Empresa reconhece e garante expressa ciência e anuência de que:</p>';
      html += '<p>a) Qualquer obrigação imposta ao iFood Benefícios nos Termos e Condições do Programa Corporativo da AVUS diversa do quanto definido no presente Anexo ou no Contrato, será nula de pleno direito;</p>';
      html += '<p>b) Havendo qualquer alteração ou atualização nos Termos e Condições do Programa Corporativo da AVUS, caberá exclusivamente à AVUS comunicar diretamente à Empresa;</p>';
      html += '<p>c) A responsabilidade do iFood Benefícios está limitada à disponibilização do acesso ao Programa, não englobando qualquer pagamento pelo iFood Benefícios de serviços prestados aos Colaboradores.</p>';
      html += '<p>I.3. <em>Privacidade e proteção de dados pessoais.</em> A Empresa concorda em cumprir integralmente com as obrigações de privacidade e proteção de dados pessoais previstas no "Acordo de Tratamento de Dados Pessoais" da Avus, disponível em <a href="https://apps.avus.com.br/termos/ACORDO_DE_LGPD_PADRAO_IFOOD.pdf" target="_blank" rel="noopener">https://apps.avus.com.br/termos/ACORDO_DE_LGPD_PADRAO_IFOOD.pdf</a>.</p>';
      html += '<p>I.3.1. A Empresa está ciente que não haverá compartilhamento de dados pessoais entre a Empresa, o iFood Benefícios e a Avus para o cumprimento deste Programa. As atividades de tratamento de dados pessoais serão exclusivas entre a Empresa e a Avus.</p>';

      // ANEXO WELLHUB (conditional)
      if (shouldShowWellhubAnnex(d.plano)) {
        html += wellhubAnnex;
      }

      document.getElementById('contractArea').innerHTML = html;
    }

    function getWellhubAnnex() {
      var h = '<h3 style="margin-top:28px;border-top:2px solid #E8D5DC;padding-top:20px;">ANEXO ESPECÍFICO — DECLARAÇÃO ACADEMIA (WELLHUB)</h3>';
      h += '<p><em>Parte integrante dos Termos e Condições Gerais de Contratação do Colab+</em></p>';
      h += '<p>Este Anexo Específico visa estabelecer os termos e condições específicos para a disponibilização do acesso, aos colaboradores da Empresa, ao programa Academia.</p>';
      h += '<h3>I. DECLARAÇÃO</h3>';
      h += '<p>I.1. Por meio desta Declaração, a Empresa reconhece e garante expressa ciência e anuência e que possui conhecimento e cumprirá com as disposições previstas nos termos e condições gerais da GPBR PARTICIPAÇÕES LTDA. ("Wellhub"), inscrita no CNPJ nº 15.664.649/0001-84, referente aos Termos e Condições do Programa Corporativo – BR da Wellhub, disponível no link <a href="https://assets-cdn.Wellhub.com/docs/legal/b2b/ic/nov_22/br_ddbb3e4c11.pdf" target="_blank" rel="noopener">https://assets-cdn.Wellhub.com/docs/legal/b2b/ic/nov_22/br_ddbb3e4c11.pdf</a>.</p>';
      h += '<p>I.2. A Empresa reconhece e garante expressa ciência e anuência de que:</p>';
      h += '<p>a) Qualquer obrigação imposta ao iFood Benefícios nos Termos e Condições do Programa Corporativo – BR da Wellhub diversa do quanto definido na presente Declaração ou no Contrato Colab+, será nula de pleno direito;</p>';
      h += '<p>b) Havendo qualquer alteração ou atualização nos Termos e Condições do Programa Corporativo – BR, caberá exclusivamente à Wellhub comunicar diretamente à Empresa;</p>';
      h += '<p>c) Os colaboradores da Empresa deverão arcar com o valor da "Coparticipação (Copay) do Colaborador", que representa o valor a ser pago pelo colaborador elegível à Wellhub. O preço e a frequência de pagamento da Copay pelos colaboradores deverão ser ajustados entre Wellhub e os colaboradores da Empresa, sem qualquer ingerência do iFood Benefícios;</p>';
      h += '<p>d) Para empresas com até 499 colaboradores, a única forma de pagamento da Coparticipação (Copay) disponível para os colaboradores é o cartão de crédito;</p>';
      h += '<p>e) Para empresas com 500 ou mais colaboradores, as opções de pagamento incluem o desconto em folha de pagamento ou cartão de crédito;</p>';
      h += '<p>f) Independentemente do número de colaboradores, estagiários e terceirizados terão como única opção de pagamento da Coparticipação (Copay) o cartão de crédito.</p>';
      h += '<p>I.3. Cabe exclusivamente à Wellhub liberar a Plataforma Wellhub para a chave de acesso indicada pela Empresa.</p>';
      h += '<p>I.4. A Empresa reconhece que a atuação do Parceiro se dá de forma independente, autônoma e sem qualquer ingerência do iFood Benefícios.</p>';
      return h;
    }

    // ---- Passo 2 → Passo 3 ----
    window.modalStep2Next = function() {
      if (!contractScrolled) return;

      // Populate summary for step 3
      var d = modalData;
      var sumHtml = '<p><strong>Empresa:</strong> ' + esc(d.razaoSocial) + '</p>' +
        '<p><strong>CNPJ:</strong> ' + esc(d.cnpj) + '</p>' +
        '<p><strong>Plano:</strong> ' + esc(d.pacote) + '</p>' +
        '<p><strong>Valor mensal:</strong> ' + esc(d.valorMensal) + '</p>' +
        '<p><strong>Data:</strong> ' + esc(d.dataHoje) + '</p>';
      document.getElementById('assinaturaSummary').innerHTML = sumHtml;

      // Update checkbox label with company name
      document.getElementById('mCheckTermosLabel').textContent =
        'Declaro que li integralmente o contrato acima, que tenho poderes para assinar em nome da empresa ' +
        d.razaoSocial + ' e que concordo com todos os termos e condições.';

      // Clear previous state
      document.getElementById('mFieldAssinatura').value = '';
      document.getElementById('mCheckTermos').checked = false;
      showErr('mFieldAssinatura', 'mErrAssinatura', false);
      document.getElementById('mErrCheckTermos').classList.remove('visible');
      document.getElementById('mErrCheckTermos').style.display = 'none';

      modalGoTo(3);
    };

    // ---- Passo 3 — Confirmar ----
    window.modalStep3Confirm = function() {
      var assinatura = document.getElementById('mFieldAssinatura').value.trim();
      var focalNome = modalData.focalNome;
      var checked = document.getElementById('mCheckTermos').checked;
      var valid = true;

      // Validate name match (case-insensitive)
      var nameMatch = assinatura.toLowerCase() === focalNome.toLowerCase();
      showErr('mFieldAssinatura', 'mErrAssinatura', !nameMatch || !assinatura);
      if (!nameMatch || !assinatura) valid = false;

      // Validate checkbox
      var errChk = document.getElementById('mErrCheckTermos');
      if (!checked) {
        errChk.classList.add('visible');
        errChk.style.display = 'block';
        valid = false;
      } else {
        errChk.classList.remove('visible');
        errChk.style.display = 'none';
      }

      if (!valid) return;

      // Fire-and-forget: send contract data to server
      (function() {
        function getUtmParams() {
          var p = new URLSearchParams(window.location.search);
          return { utm_source: p.get('utm_source') || '', utm_campaign: p.get('utm_campaign') || '' };
        }
        var utm = getUtmParams();
        var d2 = modalData;
        var payload = {
          pacote: document.getElementById('mFieldPacote') ? document.getElementById('mFieldPacote').value : '',
          razao_social: d2.razaoSocial || '',
          cnpj: (d2.cnpj || '').replace(/\D/g, ''),
          fantasia: d2.fantasia || '',
          endereco: d2.endereco || '',
          cidade: d2.cidade || '',
          estado: d2.estado || '',
          cep: (d2.cep || '').replace(/\D/g, ''),
          tel_empresa: (d2.telEmp || '').replace(/\D/g, ''),
          email_empresa: d2.emailEmp || '',
          focal_nome: d2.focalNome || '',
          focal_cargo: d2.focalCargo || '',
          focal_tel: (d2.focalTel || '').replace(/\D/g, ''),
          focal_email: d2.focalEmail || '',
          colabs: parseInt(d2.colabs || '0', 10),
          utm_source: utm.utm_source,
          utm_campaign: utm.utm_campaign
        };
        fetch('/contrato', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
          .then(function(r) { return r.json(); })
          .then(function(res) { if (!res.success) { console.error('Erro Pipedrive:', res.error); } })
          .catch(function(err) { console.error('Erro ao enviar contrato:', err); });
      })();

      // Success!
      var protocol = generateProtocol();
      var d = modalData;
      var now = nowFormatted();

      document.getElementById('successDateTime').textContent = 'Assinado em: ' + now;
      document.getElementById('successSummary').innerHTML =
        '<p><strong>Empresa:</strong> ' + esc(d.razaoSocial) + '</p>' +
        '<p><strong>CNPJ:</strong> ' + esc(d.cnpj) + '</p>' +
        '<p><strong>Plano:</strong> ' + esc(d.pacote) + '</p>' +
        '<p><strong>Valor mensal:</strong> ' + esc(d.valorMensal) + '</p>' +
        '<p><strong>Assinado por:</strong> ' + esc(assinatura) + ' (' + esc(d.focalCargo) + ')</p>';
      document.getElementById('protocolNum').textContent = protocol;

      // Show step 4 (success)
      document.querySelectorAll('.modal-step-panel').forEach(function(p) { p.classList.remove('active'); });
      document.getElementById('modalStep4').classList.add('active');
      // Hide progress bar on success
      document.querySelector('.modal-progress').style.display = 'none';
      document.getElementById('modalTitle').textContent = 'Contrato assinado!';
    };

    // On modal close, restore progress bar
    var origFechar = window.fecharModalContratar;
    window.fecharModalContratar = function() {
      document.getElementById('modalContratar').classList.remove('active');
      document.body.style.overflow = '';
      // Restore progress bar for next open
      document.querySelector('.modal-progress').style.display = '';
    };

  })();

  /* ===================================================================
     LEAD FORM
     =================================================================== */
  (function() {
    var leadForm = document.getElementById('leadForm');
    if (!leadForm) return;

    // Phone mask
    var leadTel = document.getElementById('leadTelefone');
    if (leadTel) {
      leadTel.addEventListener('input', function() {
        var v = this.value.replace(/\D/g,'');
        v = v.replace(/^(\d{2})(\d)/,'($1) $2');
        v = v.replace(/(\d{5})(\d)/,'$1-$2');
        this.value = v;
      });
    }

    // CNPJ mask for lead form
    var leadCnpj = document.getElementById('leadCnpj');
    if (leadCnpj) {
      leadCnpj.addEventListener('input', function() {
        var v = this.value.replace(/\D/g,'').substring(0, 14);
        v = v.replace(/^(\d{2})(\d)/,'$1.$2');
        v = v.replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3');
        v = v.replace(/\.([\d]{3})([\d])/,'.$1/$2');
        v = v.replace(/(\/[\d]{4})(\d)/,'$1-$2');
        this.value = v;
      });
    }

    function showLeadErr(fieldId, errId, show) {
      var f = document.getElementById(fieldId);
      var e = document.getElementById(errId);
      if (show) {
        if (f) f.classList.add('error');
        if (e) { e.classList.add('visible'); }
      } else {
        if (f) f.classList.remove('error');
        if (e) e.classList.remove('visible');
      }
    }

    function getUtmParams() {
      var p = new URLSearchParams(window.location.search);
      return {
        utm_source: p.get('utm_source') || '',
        utm_campaign: p.get('utm_campaign') || ''
      };
    }

    leadForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var nome = document.getElementById('leadNome').value.trim();
      var email = document.getElementById('leadEmail').value.trim();
      var tel = document.getElementById('leadTelefone').value.trim();
      var empresa = document.getElementById('leadEmpresa').value.trim();
      var valid = true;

      showLeadErr('leadNome', 'errLeadNome', !nome); if (!nome) valid = false;
      var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      showLeadErr('leadEmail', 'errLeadEmail', !emailOk); if (!emailOk) valid = false;
      var telOk = tel.replace(/\D/g,'').length >= 10;
      showLeadErr('leadTelefone', 'errLeadTelefone', !telOk); if (!telOk) valid = false;
      showLeadErr('leadEmpresa', 'errLeadEmpresa', !empresa); if (!empresa) valid = false;
      var leadColabs = document.getElementById('leadColabs');
      var leadColabsVal = leadColabs ? parseInt(leadColabs.value, 10) : 0;
      if (!leadColabs || isNaN(leadColabsVal) || leadColabsVal < 10) {
        var errColabs = document.getElementById('leadErrColabs');
        if (errColabs) errColabs.style.display = 'block';
        valid = false;
      } else {
        var errColabs = document.getElementById('leadErrColabs');
        if (errColabs) errColabs.style.display = 'none';
      }

      if (!valid) return;

      var utm = getUtmParams();
      var body = {
        nome: nome,
        email: email,
        telefone: tel,
        empresa: empresa,
        cnpj: (document.getElementById('leadCnpj') ? document.getElementById('leadCnpj').value : '').replace(/\D/g, ''),
        colabs: parseInt(document.getElementById('leadColabs') ? document.getElementById('leadColabs').value : 0, 10),
        plano: document.getElementById('leadPlano') ? document.getElementById('leadPlano').value : '',
        mensagem: document.getElementById('leadMensagem') ? document.getElementById('leadMensagem').value : '',
        utm_source: utm.utm_source,
        utm_campaign: utm.utm_campaign
      };

      try {
        var r = await fetch('/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        var data = await r.json();
        if (data.success) {
          leadForm.style.display = 'none';
          var s = document.getElementById('leadSuccessMessage');
          s.classList.add('visible');
          leadForm.reset();
        } else {
          console.error('Erro ao enviar lead:', data.error);
          // Still show success to user to avoid blocking experience
          leadForm.style.display = 'none';
          var s = document.getElementById('leadSuccessMessage');
          s.classList.add('visible');
        }
      } catch(err) {
        console.error('Erro ao enviar lead:', err);
        // Still show success to user to avoid blocking experience
        leadForm.style.display = 'none';
        var s = document.getElementById('leadSuccessMessage');
        s.classList.add('visible');
      }
    });
  })();


  // === FIX: Anchor navigation com offset para compensar header sticky ===
  document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
      var href = this.getAttribute('href');
      if (href === '#') return;
      e.preventDefault();
      var targetId = href.substring(1);
      var targetElement = document.getElementById(targetId);
      if (targetElement) {
        var headerHeight = 80;
        var targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - headerHeight;
        window.scrollTo({ top: targetPosition, behavior: 'smooth' });
      }
    });
  });

</script>
</body>
</html>
