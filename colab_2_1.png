<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colab+ | Benefícios de Saúde e Bem-estar para Empresas | iFood Benefícios</title>
  <meta name="description" content="Colab+ oferece benefícios de saúde, academia e telemedicina para os seus colaboradores. Preço fixo mensal, sem burocracia, sem carência." />
  <style>
    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; scroll-padding-top: 80px; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      color: #2E2E2E;
      background: #FDFDFD;
      line-height: 1.6;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }
    img { max-width: 100%; }

    /* ===== VARIABLES ===== */
    :root {
      --brand-primary: #69022D;
      --brand-primary-dark: #4a011f;
      --brand-rose: #FFC1D0;
      --brand-white: #FDFDFD;
      --brand-pink-pale: #FFE6F2;
      --gray-dark: #2E2E2E;
      --gray-mid: #6B6B6B;
      --gray-light: #F5F5F5;
      --gray-border: #E8D5DC;
      --shadow-sm: 0 2px 8px rgba(105,2,45,0.08);
      --shadow-md: 0 4px 20px rgba(105,2,45,0.12);
      --shadow-lg: 0 8px 40px rgba(105,2,45,0.16);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 20px;
      --transition: 0.25s ease;
    }

    /* ===== TYPOGRAPHY ===== */
    h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 800; line-height: 1.1; }
    h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 700; line-height: 1.15; }
    h3 { font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: 600; line-height: 1.3; }
    h4 { font-size: 1.1rem; font-weight: 600; }
    p { font-size: 1rem; font-weight: 400; line-height: 1.7; color: #6B6B6B; }

    /* ===== UTILITIES ===== */
    .container { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
    .text-center { text-align: center; }
    .section-title { color: var(--brand-primary); margin-bottom: 24px; }
    .section-subtitle { font-size: 1.1rem; color: var(--gray-mid); max-width: 640px; margin: 0 auto 48px; }
    .section-header { text-align: center; margin-bottom: 60px; }
    .badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: 20px;
      margin-bottom: 16px;
    }
    .badge-red { background: var(--brand-pink-pale); color: var(--brand-primary); }
    .badge-orange { background: var(--brand-pink-pale); color: var(--brand-primary); }

    /* ===== BUTTONS ===== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: var(--radius-sm);
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
      border: none;
      text-decoration: none;
      line-height: 1;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .btn:active { transform: translateY(0); }
    .btn-primary { background: var(--brand-primary); color: #fff; }
    .btn-primary:hover { background: var(--brand-primary-dark); }
    .btn-secondary { background: transparent; color: #fff; border: 2px solid #fff; }
    .btn-secondary:hover { background: rgba(255,255,255,0.15); }
    .btn-outline-red { background: transparent; color: var(--brand-primary); border: 2px solid var(--brand-primary); }
    .btn-outline-red:hover { background: var(--brand-primary); color: #fff; }
    .btn-ghost { background: transparent; color: var(--gray-mid); border: 2px solid var(--gray-border); }
    .btn-ghost:hover { background: var(--gray-light); color: var(--gray-dark); box-shadow: none; }
    .btn-orange { background: var(--brand-primary); color: #fff; }
    .btn-orange:hover { background: var(--brand-primary-dark); }
    .btn-lg { padding: 18px 36px; font-size: 1.1rem; }
    .btn-sm { padding: 10px 20px; font-size: 0.9rem; }
    .btn-full { width: 100%; }

    /* ===== ANIMATIONS ===== */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-30px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .animate-fadeInUp { animation: fadeInUp 0.7s ease both; }
    .animate-delay-1 { animation-delay: 0.1s; }
    .animate-delay-2 { animation-delay: 0.2s; }
    .animate-delay-3 { animation-delay: 0.3s; }
    .animate-delay-4 { animation-delay: 0.4s; }

    /* ===== HEADER / NAV ===== */
    #header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: var(--brand-primary);
      border-bottom: 1px solid var(--brand-primary-dark);
      box-shadow: var(--shadow-sm);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
      gap: 20px;
    }
    .nav-logo { display: flex; align-items: center; flex-shrink: 0; }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      justify-content: center;
    }
    .nav-links a {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fff;
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      transition: background var(--transition), color var(--transition);
    }
    .nav-links a:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .nav-cta { flex-shrink: 0; }
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 6px;
      background: none;
      border: none;
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      transition: all 0.3s;
    }
    .mobile-menu {
      display: none;
      background: var(--brand-primary);
      border-top: 1px solid var(--gray-border);
      padding: 16px 20px;
      flex-direction: column;
      gap: 8px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }
    .mobile-menu a:last-child { border-bottom: none; }

    @media (max-width: 768px) {
      .nav-links { display: none; }
      .nav-cta { display: none; }
      .hamburger { display: flex; }
    }

    /* ===== HERO ===== */
    #hero {
      background: linear-gradient(135deg, #69022D 0%, #4a011f 100%);
      position: relative;
      overflow: hidden;
      padding: 100px 0 80px;
      min-height: 580px;
      display: flex;
      align-items: center;
    }
    #hero::before {
      content: '';
      position: absolute;
      top: -80px; right: -120px;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: rgba(255,255,255,0.06);
    }
    #hero::after {
      content: '';
      position: absolute;
      bottom: -100px; left: -80px;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: rgba(255,255,255,0.04);
    }
    .hero-geo {
      position: absolute;
      top: 40px; right: 10%;
      width: 200px; height: 200px;
      opacity: 0.08;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      flex: 1 1 52%;
      min-width: 280px;
      max-width: none;
    }
    .hero-image img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-md);
      display: block;
    }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.15);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 6px 14px;
      border-radius: 20px;
      margin-bottom: 20px;
    }
    #hero h1 { color: #fff; margin-bottom: 20px; }
    #hero .hero-subtitle {
      color: rgba(255,255,255,0.92);
      font-size: 1.15rem;
      margin-bottom: 36px;
      max-width: 560px;
    }
    .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
    .hero-stats {
      display: flex;
      gap: 36px;
      margin-top: 60px;
      flex-wrap: wrap;
    }
    .hero-stat { text-align: center; }
    .hero-stat-number {
      display: block;
      font-size: 1.8rem;
      font-weight: 800;
      color: #fff;
      line-height: 1;
    }
    .hero-stat-label {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.85);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-top: 4px;
    }

    @media (max-width: 768px) {
      #hero .container {
        flex-direction: column;
        flex-wrap: wrap;
      }
      .hero-content {
        order: 1;
        max-width: 100% !important;
        flex: 1 1 100% !important;
      }
      .hero-image {
        order: 2;
        flex: 1 1 100% !important;
        max-width: 100% !important;
      }
      .hero-image img {
        width: 100%;
        height: auto;
        border-radius: var(--radius-md);
        display: block;
      }
    }

    /* ===== BENEFITS SECTION ===== */
    #beneficios { padding: 100px 0; background: var(--brand-white); }
    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 32px;
    }
    .benefit-card {
      background: #fff;
      border: 1.5px solid var(--gray-border);
      border-radius: var(--radius-md);
      padding: 36px 28px;
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
      position: relative;
      overflow: hidden;
    }
    .benefit-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: var(--brand-primary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transition);
    }
    .benefit-card:hover::before { transform: scaleX(1); }
    .benefit-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 2px 12px rgba(105,2,45,0.08);
      border-color: transparent;
    }
    .benefit-icon {
      width: 56px; height: 56px;
      background: var(--brand-pink-pale);
      border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px;
    }
        .benefit-icon--logo {
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 80px;
      margin-bottom: 16px;
      width: 100%;
    }
        .benefit-icon--logo img {
      max-height: 56px;
      max-width: 180px;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }
    .benefit-card h3 { color: var(--gray-dark); margin-bottom: 10px; font-size: 1.15rem; }
    .benefit-card p { font-size: 0.9rem; color: var(--gray-mid); margin-bottom: 16px; }
    .benefit-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .benefit-tag {
      font-size: 0.75rem;
      font-weight: 600;
      background: var(--gray-light);
      color: var(--gray-mid);
      padding: 3px 8px;
      border-radius: 12px;
    }

    /* ===== HOW IT WORKS ===== */
    #como-funciona { padding: 100px 0; background: var(--brand-pink-pale); }
    .steps-wrapper {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      position: relative;
    }
    .steps-wrapper::before {
      content: '';
      position: absolute;
      top: 40px;
      left: calc(16.67% + 20px);
      right: calc(16.67% + 20px);
      height: 2px;
      background: linear-gradient(90deg, var(--brand-primary), var(--brand-primary));
    }
    .step-card {
      text-align: center;
      position: relative;
    }
    .step-number {
      width: 80px; height: 80px;
      border-radius: 50%;
      background: var(--brand-primary);
      color: #fff;
      font-size: 1.6rem;
      font-weight: 800;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 24px;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 16px rgba(105,2,45,0.35);
    }
    .step-card h3 { color: var(--gray-dark); margin-bottom: 10px; }
    .step-card p { font-size: 0.95rem; max-width: 240px; margin: 0 auto; }

    @media (max-width: 768px) {
      .steps-wrapper { grid-template-columns: 1fr; gap: 24px; }
      .steps-wrapper::before { display: none; }
    }

    /* ===== PACKAGES / PRICING TABLE ===== */
    #pacotes { padding: 100px 0; background: var(--brand-white); }

    /* Plan benefits summary */
    .plan-summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      margin-bottom: 48px;
    }
    @media (max-width: 768px) {
      .plan-summary-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    .plan-summary-card {
      border: 1.5px solid var(--gray-border);
      border-radius: var(--radius-md);
      padding: 24px 20px;
      background: #fff;
      position: relative;
      overflow: hidden;
    }
    .plan-summary-card.featured-plan {
      border-color: var(--brand-primary);
      box-shadow: 0 2px 12px rgba(105,2,45,0.08);
    }
    .plan-summary-card.featured-plan::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: var(--brand-primary);
    }
    .plan-summary-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--gray-dark);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .plan-summary-from {
      font-size: 0.82rem;
      color: var(--gray-mid);
      margin-bottom: 14px;
    }
    .plan-summary-features {
      list-style: none;
      padding: 0;
    }
    .plan-summary-features li {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      font-size: 0.83rem;
      color: var(--gray-mid);
      padding: 4px 0;
      line-height: 1.4;
    }
    .plan-summary-features li::before {
      content: '✓';
      color: var(--brand-primary);
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* Pricing table */
    .pricing-table-wrapper {
      overflow-x: auto;
      margin-bottom: 20px;
      border-radius: var(--radius-md);
      box-shadow: 0 2px 12px rgba(105,2,45,0.08);
    }
    .pricing-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 640px;
      background: #fff;
    }
    .pricing-table th,
    .pricing-table td {
      padding: 0;
      text-align: center;
    }

    /* Header row */
    .pricing-table thead tr {
      background: #fff;
    }
    .pricing-table .th-faixa {
      padding: 20px 20px 16px;
      text-align: left;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--gray-mid);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 2px solid var(--gray-border);
      width: 28%;
    }
    .pricing-table .th-plan {
      padding: 16px 12px;
      border-bottom: 2px solid var(--gray-border);
    }
    .pricing-table .th-plan.featured {
      background: var(--brand-rose);
      border-bottom-color: var(--brand-primary);
    }
    .plan-th-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--gray-dark);
      display: block;
      margin-bottom: 2px;
    }
    .plan-th-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--brand-primary);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 3px 8px;
      border-radius: 20px;
      margin-top: 4px;
    }
    .plan-th-from {
      font-size: 0.78rem;
      color: var(--gray-mid);
      display: block;
      margin-top: 4px;
    }

    /* Body rows */
    .pricing-table tbody tr {
      border-bottom: 1px solid var(--gray-border);
    }
    .pricing-table tbody tr:last-child { border-bottom: none; }
    .pricing-table tbody tr:hover { background: var(--gray-light); }
    .pricing-table .td-faixa {
      padding: 18px 20px;
      text-align: left;
    }
    .faixa-label {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--gray-dark);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .faixa-sub {
      font-size: 0.75rem;
      color: var(--gray-mid);
      margin-top: 2px;
    }
    .pricing-table .td-price {
      padding: 18px 12px;
      vertical-align: middle;
    }
    .pricing-table .td-price.featured-col {
      background: rgba(105,2,45,0.035);
    }
    .price-value {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--brand-primary);
      display: block;
      line-height: 1;
    }
    .price-month {
      font-size: 0.72rem;
      color: var(--gray-mid);
      display: block;
      margin-top: 3px;
    }
    .btn-table-contratar {
      display: inline-block;
      margin-top: 8px;
      padding: 7px 14px;
      font-size: 0.78rem;
      font-weight: 700;
      border-radius: 6px;
      cursor: pointer;
      transition: all var(--transition);
      border: none;
      background: var(--brand-primary);
      color: #fff;
    }
    .btn-table-contratar:hover {
      background: var(--brand-primary-dark);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }
    .btn-table-contratar.ghost {
      background: transparent;
      color: var(--gray-mid);
      border: 1.5px solid var(--gray-border);
    }
    .btn-table-contratar.ghost:hover {
      background: var(--gray-light);
      color: var(--gray-dark);
      transform: none;
      box-shadow: none;
    }

    /* +100 row */
    .pricing-table .tr-consultor {
      background: white;
    }
    .pricing-table .tr-consultor:hover { background: var(--brand-rose); }
    .td-consultor {
      padding: 18px 12px;
      text-align: center;
      vertical-align: middle;
    }
    .consultor-text {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--brand-primary);
      display: block;
    }

    .pricing-note {
      text-align: center;
      font-size: 0.88rem;
      color: var(--gray-mid);
      margin-top: 20px;
      padding: 14px 20px;
      background: var(--gray-light);
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--brand-primary);
    }
    .pricing-note strong { color: var(--gray-dark); }

    /* ===== SIMULATOR ===== */
    #simulador { padding: 96px 0; background: var(--brand-pink-pale); }
    .simulator-wrapper {
      background: var(--brand-white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      max-width: 860px;
      margin: 0 auto;
    }
    .sim-header {
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-primary-dark));
      padding: 32px 40px;
      color: #fff;
    }
    .sim-header h3 { color: #fff; font-size: 1.3rem; margin-bottom: 4px; }
    .sim-header p { color: rgba(255,255,255,0.8); font-size: 0.95rem; }
    .sim-body { padding: 40px; }
    .sim-row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 32px; }
    @media (max-width: 600px) {
      .sim-row { grid-template-columns: 1fr; gap: 20px; }
      .sim-body { padding: 24px 20px; }
      .sim-header { padding: 24px 20px; }
    }
    .sim-field label {
      display: block;
      font-weight: 700;
      color: var(--gray-dark);
      margin-bottom: 10px;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .sim-input {
      width: 100%;
      border: 2px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--gray-dark);
      font-family: inherit;
      transition: border-color var(--transition);
      -webkit-appearance: none;
    }
    .sim-input:focus { outline: none; border-color: var(--brand-primary); }
    .sim-slider-row {
      display: flex; align-items: center; gap: 12px; margin-top: 8px;
    }
    .sim-slider {
      flex: 1;
      -webkit-appearance: none;
      height: 6px;
      border-radius: 3px;
      background: var(--gray-border);
      outline: none;
    }
    .sim-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--brand-primary);
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(234,29,44,0.4);
    }
    .sim-slider::-moz-range-thumb {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--brand-primary);
      cursor: pointer;
      border: none;
      box-shadow: 0 2px 8px rgba(234,29,44,0.4);
    }
    .sim-slider-value {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--brand-primary);
      min-width: 48px;
      text-align: right;
    }
    .sim-plan-options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    @media (max-width: 500px) {
      .sim-plan-options { grid-template-columns: 1fr; }
    }
    .sim-plan-option {
      border: 2px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 14px 12px;
      cursor: pointer;
      text-align: center;
      transition: all var(--transition);
    }
    .sim-plan-option:hover { border-color: var(--brand-primary); background: var(--brand-rose); }
    .sim-plan-option.selected { border-color: var(--brand-primary); background: var(--brand-rose); }
    .sim-plan-option input[type="radio"] { display: none; }
    .sim-plan-name { font-weight: 700; font-size: 0.9rem; color: var(--gray-dark); display: block; }
    .sim-plan-hint { font-size: 0.75rem; color: var(--gray-mid); display: block; margin-top: 3px; }
    .sim-result {
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .sim-result-empty {
      padding: 40px;
      text-align: center;
      background: var(--gray-light);
      border-radius: var(--radius-md);
    }
    .sim-result-empty p { color: var(--gray-mid); }
    .sim-result-content {
      display: none;
      border: 2px solid var(--brand-primary);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .sim-result-content.visible { display: block; animation: fadeInUp 0.4s ease; }
    .sim-result-header {
      background: var(--brand-primary);
      padding: 20px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .sim-result-pkg-name { color: #fff; font-size: 1.3rem; font-weight: 800; }
    .sim-result-price-block { text-align: right; }
    .sim-result-price {
      color: #fff;
      font-size: 2rem;
      font-weight: 800;
      display: block;
      line-height: 1;
    }
    .sim-result-price-sub { color: rgba(255,255,255,0.8); font-size: 0.82rem; }
    .sim-result-body { padding: 24px 28px; }
    .sim-result-meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }
    @media (max-width: 500px) {
      .sim-result-meta { grid-template-columns: 1fr 1fr; }
    }
    .sim-result-meta-item {
      background: var(--gray-light);
      border-radius: var(--radius-sm);
      padding: 14px;
      text-align: center;
    }
    .sim-meta-value { font-size: 1.2rem; font-weight: 800; color: var(--gray-dark); display: block; }
    .sim-meta-label { font-size: 0.75rem; color: var(--gray-mid); text-transform: uppercase; letter-spacing: 0.05em; }
    .sim-result-features h4 { color: var(--brand-primary); margin-bottom: 12px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .sim-features-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .sim-feature-tag {
      background: var(--brand-rose);
      color: var(--brand-primary);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 20px;
    }
    .sim-disclaimer {
      font-size: 0.82rem;
      color: var(--gray-mid);
      margin-bottom: 24px;
      padding: 12px 16px;
      background: var(--brand-rose); border-color: var(--brand-primary);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .sim-disclaimer strong { color: var(--gray-dark); }
    .sim-contact-needed {
      display: none;
      background: var(--brand-rose); border-color: var(--brand-primary);
      border-radius: var(--radius-md);
      padding: 28px;
      text-align: center;
    }
    .sim-contact-needed.visible { display: block; animation: fadeInUp 0.4s ease; }
    .sim-contact-needed h4 { color: var(--gray-dark); font-size: 1.1rem; margin-bottom: 8px; }
    .sim-contact-needed p { font-size: 0.9rem; color: var(--gray-mid); margin-bottom: 20px; }

    /* ===== CONTRATAR ===== */
    /* contratar section styles moved to new block */
    .warning-banner {
      background: var(--brand-rose);
      border: 2px solid var(--brand-primary);
      border-radius: var(--radius-md);
      padding: 24px 28px;
      margin-bottom: 36px;
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .warning-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
      line-height: 1;
    }
    .warning-text h4 {
      font-size: 1rem;
      color: #E65100;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .warning-text p {
      font-size: 0.9rem;
      color: #BF360C;
      line-height: 1.5;
    }
    .warning-text a { color: var(--brand-primary); font-weight: 600; text-decoration: underline; }
    .form-card {
      background: #fff;
      border: 1.5px solid var(--gray-border);
      border-radius: var(--radius-lg);
      padding: 40px;
      box-shadow: var(--shadow-sm);
    }
    @media (max-width: 600px) {
      .form-card { padding: 24px 20px; }
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 600px) {
      .form-row { grid-template-columns: 1fr; gap: 16px; }
    }
    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block;
      font-weight: 600;
      color: var(--gray-dark);
      margin-bottom: 7px;
      font-size: 0.9rem;
    }
    .form-group label span.required { color: var(--brand-primary); margin-left: 2px; }
    .form-control {
      width: 100%;
      border: 1.5px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      font-size: 0.95rem;
      font-family: inherit;
      color: var(--gray-dark);
      transition: border-color var(--transition), box-shadow var(--transition);
      background: #fff;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(234,29,44,0.1);
    }
    .form-control.error { border-color: var(--brand-primary); }
    .form-error {
      font-size: 0.8rem;
      color: var(--brand-primary);
      margin-top: 4px;
      display: none;
    }
    .form-error.visible { display: block; }
    .checkbox-group { margin-bottom: 16px; }
    .checkbox-label {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      cursor: pointer;
      font-size: 0.9rem;
      color: var(--gray-mid);
      line-height: 1.4;
    }
    .checkbox-label input[type="checkbox"] {
      width: 18px; height: 18px;
      flex-shrink: 0;
      accent-color: var(--brand-primary);
      margin-top: 1px;
      cursor: pointer;
    }
    .checkbox-label strong { color: var(--gray-dark); }
    .checkbox-label a { color: var(--brand-primary); text-decoration: underline; }
    .form-divider {
      border: none;
      border-top: 1px solid var(--gray-border);
      margin: 24px 0;
    }
    .form-section-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gray-mid);
      margin-bottom: 20px;
    }
    .success-message {
      display: none;
      background: #E8F5E9;
      border: 2px solid #4CAF50;
      border-radius: var(--radius-md);
      padding: 32px;
      text-align: center;
    }
    .success-message.visible { display: block; animation: fadeInUp 0.5s ease; }
    .success-icon {
      width: 64px; height: 64px;
      background: #4CAF50;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
    }
    .success-message h3 { color: #2E7D32; font-size: 1.3rem; margin-bottom: 10px; }
    .success-message p { color: #388E3C; font-size: 0.95rem; }

    /* ===== FAQ ===== */
    #faq { padding: 96px 0; background: var(--gray-light); }
    .faq-list { max-width: 720px; margin: 0 auto; }
    .faq-item {
      background: #fff;
      border: 1.5px solid var(--gray-border);
      border-radius: var(--radius-md);
      margin-bottom: 12px;
      overflow: hidden;
      transition: box-shadow var(--transition);
    }
    .faq-item:hover { box-shadow: var(--shadow-sm); }
    .faq-question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      cursor: pointer;
      gap: 16px;
    }
    .faq-question h4 {
      font-size: 0.95rem;
      color: #2E2E2E;
      font-weight: 600;
      flex: 1;
    }
    .faq-toggle {
      width: 28px; height: 28px;
      background: var(--gray-light);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      transition: background var(--transition), transform var(--transition);
    }
    .faq-item.open .faq-toggle {
      background: var(--brand-primary);
      transform: rotate(45deg);
    }
    .faq-answer {
      display: none;
      padding: 0 24px 20px;
    }
    .faq-answer p {
      font-size: 0.9rem;
      color: var(--gray-mid);
      line-height: 1.65;
    }
    .faq-item.open .faq-answer { display: block; animation: fadeIn 0.3s ease; }

    /* ===== FOOTER ===== */
    #footer {
      background: var(--brand-primary);
      padding: 60px 0;
    }
    .footer-top {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 48px;
      padding-bottom: 40px;
      border-bottom: 1px solid rgba(255,255,255,0.2);
      margin-bottom: 32px;
    }
    @media (max-width: 768px) {
      .footer-top { grid-template-columns: 1fr; gap: 32px; }
    }
    .footer-brand p {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.6);
      margin-top: 16px;
      max-width: 280px;
    }
    .footer-col h5 {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.45);
      margin-bottom: 16px;
    }
    .footer-col a {
      display: block;
      font-size: 0.9rem;
      color: rgba(255,255,255,0.85);
      padding: 5px 0;
      transition: color var(--transition);
    }
    .footer-col a:hover { color: #fff; }
    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .footer-copy {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.5);
    }
    .footer-legal { display: flex; gap: 20px; }
    .footer-legal a {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.5);
      transition: color var(--transition);
    }
    .footer-legal a:hover { color: #fff; }

    /* ===== SECTION PADDING ===== */
    section { position: relative; }

    /* ===== SCROLL TOP ===== */
    .scroll-top {
      position: fixed;
      bottom: 28px; right: 28px;
      width: 46px; height: 46px;
      background: var(--brand-primary);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 12px rgba(105,2,45,0.08);
      cursor: pointer;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity var(--transition), transform var(--transition);
      z-index: 900;
      border: none;
    }
    .scroll-top.visible { opacity: 1; transform: translateY(0); }
    .scroll-top:hover { background: var(--brand-primary-dark); }

    /* ===== TRUST BAR ===== */
    .trust-bar {
      background: #fff;
      border-bottom: 1px solid var(--gray-border);
      padding: 16px 0;
    }
    .trust-items {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 40px;
      flex-wrap: wrap;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--gray-mid);
      font-weight: 500;
    }
    .trust-item svg { color: var(--brand-primary); }

    /* ===== SELECT OPTGROUP ===== */
    select optgroup { font-weight: 700; color: var(--gray-dark); }
  
    /* Partner badges */
    .partner-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 20px;
      margin-left: 6px;
      color: white;
    }
  
    /* ===== CONTRATAR TWO-CARD LAYOUT ===== */
    #contratar { padding: 96px 0; background: var(--brand-white); }
    .contratar-opcoes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
    @media (max-width: 768px) {
      .contratar-opcoes { grid-template-columns: 1fr; }
    }
    .contratar-card {
      background: #fff;
      border: 1px solid #E8D5DC;
      border-radius: 16px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .contratar-card--destaque {
      border-color: var(--brand-primary);
      box-shadow: 0 4px 24px rgba(105,2,45,0.10);
    }
    .contratar-card-icon {
      color: var(--brand-primary);
      margin-bottom: 4px;
    }
    .contratar-card h3 {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--gray-dark);
      margin: 0;
    }
    .contratar-card p {
      color: #555;
      margin: 0;
      line-height: 1.6;
    }
    .contratar-card-benefits {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .contratar-card-benefits li {
      color: #333;
      font-size: 0.95rem;
    }
    .lead-form { display: flex; flex-direction: column; gap: 12px; }
    .lead-form .form-group { margin-bottom: 0; }

    /* ===== MODAL AUTOCONTRATAÇÃO ===== */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 10000;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
      background: #fff;
      border-radius: 16px;
      width: 100%;
      max-width: 700px;
      max-height: 92vh;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 28px 0;
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 1;
      padding-top: 20px;
    }
    .modal-header h2 { font-size: 1.2rem; font-weight: 700; color: var(--gray-dark); margin: 0; }
    .modal-close {
      background: none;
      border: none;
      font-size: 1.6rem;
      cursor: pointer;
      color: #666;
      padding: 4px 8px;
      line-height: 1;
    }
    .modal-close:hover { color: var(--brand-primary); }

    /* Progress bar */
    .modal-progress {
      display: flex;
      align-items: center;
      padding: 16px 28px;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid #eee;
    }
    .progress-step {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      position: relative;
    }
    .progress-step-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #E8D5DC;
      color: #888;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: 700;
      flex-shrink: 0;
      transition: all 0.3s;
    }
    .progress-step.active .progress-step-num,
    .progress-step.done .progress-step-num {
      background: var(--brand-primary);
      color: #fff;
    }
    .progress-step-label {
      font-size: 0.8rem;
      color: #888;
      font-weight: 500;
      white-space: nowrap;
    }
    .progress-step.active .progress-step-label,
    .progress-step.done .progress-step-label { color: var(--brand-primary); font-weight: 700; }
    .progress-connector {
      height: 2px;
      background: #E8D5DC;
      flex: 1;
      margin: 0 8px;
      transition: background 0.3s;
    }
    .progress-connector.done { background: var(--brand-primary); }

    .modal-body { padding: 24px 28px 28px; flex: 1; }

    /* Passo 1 – form fields */
    .modal-form-section { margin-bottom: 8px; }
    .modal-form-section-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--brand-primary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 2px solid #E8D5DC;
    }

    /* Passo 2 – contract area */
    .contract-area {
      background: #FAFAFA;
      border: 1px solid #E8D5DC;
      border-radius: 8px;
      padding: 24px;
      max-height: 55vh;
      overflow-y: scroll;
      font-size: 0.85rem;
      line-height: 1.6;
      color: #333;
      scroll-behavior: smooth;
    }
    .contract-area h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--gray-dark);
      margin: 20px 0 6px;
    }
    .contract-area h3:first-child { margin-top: 0; }
    .contract-area p { margin: 4px 0 10px; }
    .contract-area ul { padding-left: 20px; margin: 6px 0 10px; }
    .contract-area li { margin-bottom: 4px; }
    .contract-header {
      border: 1px solid #E8D5DC;
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 20px;
      background: #fff;
    }
    .contract-header p { margin: 2px 0; font-size: 0.84rem; }
    .contract-header strong { color: var(--gray-dark); }

    /* Scroll hint */
    .scroll-hint {
      font-size: 0.78rem;
      color: #888;
      text-align: center;
      padding: 8px 0 4px;
    }

    /* Passo 3 – assinatura */
    .assinatura-summary {
      background: #FAFAFA;
      border: 1px solid #E8D5DC;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .assinatura-summary p { margin: 4px 0; font-size: 0.9rem; }
    .assinatura-summary strong { color: var(--gray-dark); }

    /* Success step inside modal */
    .modal-success {
      text-align: center;
      padding: 32px 16px;
    }
    .modal-success .success-icon {
      background: #22A37C;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }
    .modal-success h3 { color: var(--gray-dark); margin-bottom: 12px; }
    .modal-success p { color: #555; margin-bottom: 8px; }
    .modal-success .protocol-num {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--brand-primary);
      letter-spacing: 0.1em;
    }

    .btn-modal-next {
      background: var(--brand-primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      width: 100%;
      margin-top: 20px;
      transition: background 0.2s;
    }
    .btn-modal-next:hover:not(:disabled) { background: #8a0038; }
    .btn-modal-next:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-modal-back {
      background: none;
      border: 1px solid #ccc;
      border-radius: 8px;
      padding: 12px 28px;
      font-size: 0.95rem;
      cursor: pointer;
      width: 100%;
      margin-top: 8px;
      color: #555;
    }
    .btn-modal-back:hover { border-color: var(--brand-primary); color: var(--brand-primary); }
    .modal-step-panel { display: none; }
    .modal-step-panel.active { display: block; }

    .checkbox-group-modal {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 12px;
    }
    .checkbox-group-modal input[type="checkbox"] {
      margin-top: 3px;
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      accent-color: var(--brand-primary);
      cursor: pointer;
    }
    .checkbox-group-modal label { font-size: 0.9rem; color: #333; cursor: pointer; }
    .err-modal { color: #e53e3e; font-size: 0.82rem; display: none; margin-top: 4px; }
    .err-modal.visible { display: block; }
    
    /* UF select within form-row */
    .form-row .form-row { flex-wrap: wrap; }
</style>
</head>
<body>

<!-- ===== HEADER ===== -->
<header id="header">
  <div class="container">
    <nav class="nav-inner">
      <a href="#" class="nav-logo" aria-label="Colab+ Home">
        <img src="data:image/png;base64," alt="Colab+ logo" style="height: 40px; width: auto; display: block;">
        <!-- Logo Colab+ (branca) carregada - height: 40px -->
      </a>

      <ul class="nav-links" role="navigation" aria-label="Navegação principal">
        <li><a href="#beneficios">Benefícios</a></li>
        <li><a href="#pacotes">Pacotes</a></li>
        <li><a href="#simulador">Simulador</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>

      <div class="nav-cta">
        <a href="#contratar" class="btn btn-primary">Quero contratar</a>
      </div>

      <button class="hamburger" id="hamburgerBtn" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
  <div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Navegação mobile">
    <a href="#beneficios" onclick="closeMobileMenu()">Benefícios</a>
    <a href="#pacotes" onclick="closeMobileMenu()">Pacotes</a>
    <a href="#simulador" onclick="closeMobileMenu()">Simulador</a>
